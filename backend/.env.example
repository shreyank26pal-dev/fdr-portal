# Copy to .env and adjust. Defaults work with `docker compose up`.

# When running the API on your machine (not in docker) against the docker database:
DATABASE_URL=postgresql+psycopg://fdr:fdr@localhost:5432/fdr_portal

# CHANGE THESE outside a hackathon demo
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

# Email: Mailpit from docker-compose catches every email -> http://localhost:8025
# Leave SMTP_HOST empty to only log emails as SIMULATED.
SMTP_HOST=localhost
SMTP_PORT=1025

# OCR: Tesseract is used by default. On Windows, install it and set the path:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional: Google Cloud Vision (used instead of Tesseract when set)
GOOGLE_VISION_API_KEY=

MOCK_BANK_API_KEY=sandbox-bank-key
ENABLE_SCHEDULER=true
DEMO_MODE=true
